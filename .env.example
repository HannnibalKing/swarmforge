# Database
DATABASE_URL=postgres://swarmforge:dev_password_change_in_prod@localhost:5432/swarmforge?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swarmforge
DB_USER=swarmforge
DB_PASSWORD=dev_password_change_in_prod

# Redis
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://swarmforge:dev_password@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=swarmforge
RABBITMQ_PASSWORD=dev_password

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
S3_BUCKET_MODELS=swarmforge-models
S3_BUCKET_QA_PHOTOS=swarmforge-qa-photos

# JWT
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-string
JWT_EXPIRY=24h

# API
API_PORT=8080
API_HOST=0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# QA Service
QA_SERVICE_PORT=3001
AI_MODEL_ENDPOINT=http://localhost:8000  # For defect detection AI

# WebSocket
WS_PORT=3002

# Environment
NODE_ENV=development
GO_ENV=development

# Printer Certification
MIN_CALIBRATION_SCORE=85
GOLD_TIER_MIN_SCORE=90
PLATINUM_TIER_MIN_SCORE=95

# Job Distribution
MAX_PARTS_PER_JOB=50
REDUNDANCY_FACTOR=1.2
DEFAULT_QA_TIMEOUT_HOURS=48
